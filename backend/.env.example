APP_NAME="KaamSetu"
ENVIRONMENT="development"
DEBUG=True
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/kaamsetu"
JWT_SECRET_KEY="change-this-secret-key-in-production"
FRONTEND_URL="http://localhost:5173"
ADMIN_EMAIL="admin@kaamsetu.in"
ADMIN_PASSWORD="Admin@KaamSetu123!"

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# OTP & Verification
MOCK_OTP_MODE=True
OTP_SECRET_KEY="your-strong-hmac-sha256-otp-secret"
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15

# Email Delivery Provider (Option A: smtp, Option B: resend)
EMAIL_PROVIDER=""
# SMTP Configuration
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="apikey_or_username"
SMTP_PASSWORD="your_smtp_password"
SMTP_FROM_EMAIL="noreply@kaamsetu.in"
SMTP_TLS=True
SMTP_SSL=False
# Resend Configuration
RESEND_API_KEY="re_123456789"
RESEND_FROM_EMAIL="noreply@kaamsetu.in"

# SMS Delivery Provider (Option A: msg91, Option B: twilio)
SMS_PROVIDER=""
# MSG91 Configuration (India)
MSG91_AUTH_KEY="your_msg91_authkey"
MSG91_TEMPLATE_ID="your_msg91_otp_template_id"
MSG91_SENDER_ID="KMSETU"
# Twilio Configuration
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_FROM_NUMBER="+1234567890"
